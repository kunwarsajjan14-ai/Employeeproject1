<Window x:Class="Employeeproject1.PayrollManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Employeeproject1"
        mc:Ignorable="d"
        Title="EmployeeManagementWindow" Height="650" Width="850"
        Background="Aquamarine">

    <StackPanel Margin="40">
        <TextBlock Text="Payroll Management"
                FontSize="30"
                FontWeight="Bold"
                HorizontalAlignment="Center"
                Margin="0,10,0,30"/>

        <DataGrid x:Name="dgPayroll"
              Height="300"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              Margin="0,0,0,20">


            <DataGrid.Columns>
                <DataGridTextColumn Header="Employee ID"
                      Binding = "{Binding EmployeeID}"
                      Width="*"/>

                <DataGridTextColumn Header="Employee Name"
                      Binding = "{Binding EmployeeName}"
                      Width="*"/>

                <DataGridTextColumn Header="Gross Salary"
                          Binding = "{Binding GrossSalary}"
                          Width="*"/>

                <DataGridTextColumn Header="Tax"
                          Binding = "{Binding Tax}"
                          Width="*"/>

                <DataGridTextColumn Header="Net Salary"
                          Binding = "{Binding NetSalary}"
                          Width="*"/>

            </DataGrid.Columns>

        </DataGrid>

        <StackPanel Orientation="Horizontal"
              HorizontalAlignment="Center">

            <Button Content="Add Payroll"
              Width="120"
              Height="40"
              Margin="5"
              Click="Add_Click"/>

            <Button Content="Update"
              Width="120"
              Height="40"
              Margin="5"
              Click="Update_Click"/>

            <Button Content="Delete"
             Width="120"
             Height="40"
             Margin="5"
             Click="Delete_Click"/>

            <Button Content="Back"
               Width= "120"
               Height="40"
               HorizontalAlignment="Center"
               Margin="5"
               Click="Back_Click"     />


        </StackPanel>


    </StackPanel>

</Window>