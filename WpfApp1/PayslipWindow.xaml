<Window x:Class="Employeeproject1.PayslipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Employeeproject1"
        mc:Ignorable="d"
        Title="PayslipWindow" Height="500" Width="500"
        Background="FloralWhite">
    <StackPanel Margin="50">

        <TextBlock Text="My Payslip"
            FontSize="30"
            FontWeight="Bold"
            HorizontalAlignment="Center"
            Margin="0,10,0,30"/>

        <TextBlock Text="Employee Name:"
            FontWeight="Bold"></TextBlock>

        <TextBlock x:Name="txtEmployeeName"
                   Text="John"
                   FontSize="16"
                   Margin="0,5,0,20"/>
        <TextBlock Text="Pay Period"
                   FontWeight="Bold"></TextBlock>

        <TextBlock x:Name="txtPayPeriod"
           Text="October 2026"
           FontSize="16"
           Margin="0,5,0,20"/>

        <TextBlock Text="Gross Salary"
           FontWeight="Bold"></TextBlock>

        <TextBlock x:Name="txtGrossSalary"
           Text="10,000"
           FontSize="16"
           Margin="0,5,0,20"/>

        <TextBlock Text="Tax Deduction"
          FontWeight= "Bold"></TextBlock>

        <TextBlock x:Name="txtTax"
           Text="1,000"
           FontSize="16"
           Margin="0,5,0,20"/>

        <TextBlock Text="Net Salary"
          FontWeight= "Bold"></TextBlock>

        <TextBlock x:Name="txtNetSalary"
           Text="9,000"
           FontSize="16"
           FontWeight="Bold"
           Margin="0,5,0,20"/>

        <Button Content="Back"
          Width= "220"
          Height="40"
          HorizontalAlignment="Center"
          Margin="0,5"
          Click="Back_Click"     />

    </StackPanel>
</Window>