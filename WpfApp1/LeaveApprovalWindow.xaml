<Window x:Class="Employeeproject1.LeaveApprovalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Employeeproject1"
        mc:Ignorable="d"
        Title="LeaveApprovalWindow" Height="500" Width="800"
        Background="Aquamarine">
    <StackPanel Margin="40">



        <TextBlock Text="Manage Leave Request"
                    FontSize="30"
                    FontWeight="Bold"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,30"/>
        <DataGrid x:Name="dgLeaveRequest"
                  Height="300"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  >



            <DataGrid.Columns>
                <DataGridTextColumn Header="Employee"
                                Binding = "{Binding EmployeeName}"
                                Width="*"/>



                <DataGridTextColumn Header="Leave Type"
                                Binding = "{Binding LeaveType}"
                                Width="*"/>



                <DataGridTextColumn Header="Start Date"
                                    Binding = "{Binding StartDate}"
                                    Width="*"/>



                <DataGridTextColumn Header="End Date"
                                    Binding = "{Binding EndDate}"
                                    Width="*"/>



                <DataGridTextColumn Header="Status"
                                    Binding = "{Binding Status}"
                                    Width="*"/>



            </DataGrid.Columns>



        </DataGrid>
    </StackPanel>
</Window>


